# Generated by scripts/quadlet.sh from scripts/config.sh - do not edit by hand.
# Same hardening and limits as scripts/run.sh. RR port: 127.0.0.1:62354.
[Unit]
Description=Robot Raconteur Nav2 bridge (ROS 2 Jazzy, algorithm only)
After=network-online.target

[Container]
Image=localhost/rr-nav2-bridge:dev
ContainerName=rr-nav2-run
PodmanArgs=--label project=rr_nav2_bridge
PodmanArgs=--init
PodmanArgs=--cap-drop=ALL
PodmanArgs=--security-opt=no-new-privileges
PodmanArgs=--read-only
PodmanArgs=--tmpfs /tmp:rw,nosuid,nodev,size=1g
PodmanArgs=--tmpfs /home/nav/.ros:rw,nosuid,nodev,size=512m,mode=0700,U
PodmanArgs=--tmpfs /run:rw,nosuid,nodev,size=64m
PodmanArgs=--tmpfs /home/nav/.local:rw,nosuid,nodev,size=64m,mode=0700,U
PodmanArgs=--shm-size=512m
PodmanArgs=--memory=58g
PodmanArgs=--memory-swap=58g
PodmanArgs=--cpus=10
PodmanArgs=--pids-limit=512
PodmanArgs=--network=bridge
PodmanArgs=-p 127.0.0.1:62354:62354
PodmanArgs=-e RR_NAV2_PORT=62354
PodmanArgs=-e RR_NAV2_ROS_LOG_LEVEL=warn

[Service]
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
